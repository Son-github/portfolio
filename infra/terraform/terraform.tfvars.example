# 값 수정용 예제입니다. 이 파일 자체는 Terraform이 자동으로 읽지 않습니다.
# 실제 인증 키나 세션 토큰은 입력하지 마세요.
aws_profile         = "default"
# S3·배포 리전입니다. 인증서는 providers.tf의 us-east-1 별칭을 사용합니다.
aws_region          = "ap-northeast-2"
expected_account_id = "953013523670"
project_name        = "son-jongin-portfolio"
domain_name         = "www.son-portfolio.site"

# 인증서 요청 → 가비아 인증 CNAME 등록 → 도메인 연결 순서입니다.
request_certificate  = false
enable_custom_domain = false
force_destroy_bucket = false

# GitHub Actions 역할도 정의만 제공하며 기본은 비활성화입니다.
enable_github_actions        = false
github_repository            = "Son-github/portfolio"
github_deploy_branch         = "main"
# 계정에 GitHub OIDC 제공자가 이미 있으면 false로 유지해 재사용합니다.
create_github_oidc_provider  = false

# Son-github/portfolio의 공개 숫자 ID입니다. OIDC의 새 subject 형식에 사용합니다.
github_owner_id      = "83553103"
github_repository_id = "1432895806"

# 기존 예산 재사용: docs/OPERATIONS.md 확인 후 실제 로컬 tfvars에만 설정하세요.
# 실제 이메일을 이 예제 또는 GitHub에 커밋하지 마세요.
enable_cost_budget = false
cost_budget_name   = "My Monthly Cost Budget"
budget_alert_email = ""
